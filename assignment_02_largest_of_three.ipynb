    "n1, n2, n3 = map(int, (input(\"Enter Three Numbers: \")).split())\n",
    "num_list = [n1, n2 , n3]\n",
    "largest_number = num_list[0]\n",
    "for num in num_list:\n",
    "    if num > largest_number:\n",
    "        largest_number = num\n",
    "\n",
    "print(largest_number)\n"
   ]
